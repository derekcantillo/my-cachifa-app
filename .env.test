# Config the Jest suite is bundled with, so tests never depend on the `.env` a
# developer happens to have locally (`babel.config.js` picks this file when
# NODE_ENV=test). Committed on purpose.

# The data-layer tests assert against the in-memory seed data.
API_MODE=mock

# No failures: the error paths are exercised with explicit stubs instead.
MOCK_FAILURE_RATE=0

# Left empty so `src/config/env.ts` resolves its per-platform default, which is
# what `__tests__/env.test.ts` checks. `pnpm test:api` therefore talks to a
# backend on localhost:3000.
API_HOST=
API_PORT=
API_BASE_URL=
API_TIMEOUT_MS=
