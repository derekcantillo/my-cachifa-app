# Base URL of my-cachifa-backend.
# Leave empty to use the per-platform emulator defaults resolved in src/config/env.ts
# (Android emulator: http://10.0.2.2:3000 — iOS simulator: http://localhost:3000).
# Set it to your machine's LAN address when running on a physical device.
API_BASE_URL=

# 'mock' (default) serves in-memory seed data with simulated latency.
# 'http' calls my-cachifa-backend through the repositories in src/api/repositories/http.
API_MODE=mock
