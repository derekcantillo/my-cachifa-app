# ─── Backend location ────────────────────────────────────────────────────────
# The app talks to my-cachifa-backend at http://<host>:<port>/api/v1.
# Only the host changes between the three ways this app runs:
#
#   Android emulator → 10.0.2.2   (default, nothing to set)
#   iOS simulator    → localhost  (default, nothing to set)
#   Physical device  → your machine's LAN IP — set API_HOST below.
#
# On a real phone neither alias resolves, so point API_HOST at the machine
# running the backend (`ipconfig getifaddr en0` on macOS) and keep the phone on
# the same Wi-Fi. The backend already listens on 0.0.0.0.
API_HOST=

# Port the backend listens on. Defaults to 3000.
API_PORT=

# Full override for when the backend is not on the LAN at all (a tunnel, a
# staging host). Takes precedence over API_HOST/API_PORT. The '/api/v1' prefix
# is appended automatically, so an origin is enough:
# API_BASE_URL=https://mi-tunel.ngrok.app
API_BASE_URL=

# How long a request may hang before it fails as a timeout, in ms. Defaults to
# 10000. Lower it (e.g. 2000) to exercise the timeout state of the screens.
API_TIMEOUT_MS=

# ─── Data source ─────────────────────────────────────────────────────────────
# 'mock' (default) serves in-memory seed data with simulated latency.
# 'http' calls my-cachifa-backend through the repositories in src/api/repositories/http.
API_MODE=mock

# Share of mock writes that fail, 0-1. Leave empty or 0 for none; raise it
# (e.g. 0.3) to exercise the error states of the create/edit/delete screens.
# Ignored when API_MODE=http.
MOCK_FAILURE_RATE=0
